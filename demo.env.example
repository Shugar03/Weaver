# Weaver demo — Monad-only (Metropolis Track 04).
# Copiar a demo.env y completar los secrets. demo.env está gitignored.
PORT=3501
HOST=127.0.0.1
OPERATOR_KEY=<api key del operador — fija el auth admin>
REMOTE_ONLY=1
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/weaver_dev

# Settlement — solo EVM/Monad
SETTLE_CHAIN=evm
SETTLEMENT_SECRET=<private key 0x… del operador — fondea y libera escrows>
SETTLEMENT_CONTRACT=0x51acE4858652D942dC7b320870e4CDbc5c989cD6
EVM_RPC_URL=https://testnet-rpc.monad.xyz
EVM_USDC=0x534b2f3A21130d7a60830c2Df862319e593943A3
EVM_ESCROW_FROM_BLOCK=67940000
EVM_PAYOUT=10000

# ERC-8004 (Monad testnet)
ERC8004_IDENTITY=0x8004a818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
