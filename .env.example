# Weaver — envs para el stack live en testnet (ADR-0005/0006/0007).
# Todo es opt-in: sin una var, la pieza queda off y el gateway degrada honesto.

# ─── gateway (apps/gateway) ────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1

# Persistencia: sin DATABASE_URL todo es in-memory (dev). Con ella:
# cuentas, ledger, keys, samples, forges y journal sobreviven restarts.
#   DATABASE_URL=postgres://user:pass@localhost:5432/weaver
#   pnpm --filter @weaver/db migrate   # aplica migrations/*.sql en orden
DATABASE_URL=

# Billing por cuenta (ADR-0007). stroops por Mtok (1 USDC = 10^7 stroops):
#   MODEL_PRICING='{"qwen3:4b":{"prompt":1000,"completion":3000,"image":0}}'
#   $0.01/Mtok prompt = 100000 stroops. image = flat por generación.
MODEL_PRICING=

# Marketplace (ADR-0007 S48): metadata declarada — lo que no esté acá sale
# "not declared" en /models, jamás se inventa.
#   MODEL_CATALOG='{"qwen3:4b":{"name":"Qwen3 4B","description":"…","context":32768,"features":["tools","reasoning"],"docs":"https://ollama.com/library/qwen3"}}'
# Ejemplo completo con los modelos del stack local: apps/gateway/catalog.example.json
MODEL_CATALOG=

# Deposit watcher (ADR-0007): acredita pagos clásicos USDC con memo=cuenta.
# Solo arranca con DEPOSIT_ADDRESS + USDC_ISSUER + DATABASE_URL.
DEPOSIT_ADDRESS=        # G... del operador que recibe los topups
USDC_ISSUER=            # G... issuer del USDC aceptado (testnet)
HORIZON_URL=https://horizon-testnet.stellar.org
DEPOSIT_POLL_MS=15000

# Settlement escrow (ADR-0006): ambos requeridos o el settle queda off.
# SETTLEMENT_SECRET = secret S... del operador (admin del contrato).
SETTLEMENT_SECRET=
SETTLEMENT_CONTRACT=    # C... del contrato v4 deployado (deploy.sh)
SOROBAN_RPC=https://soroban-testnet.stellar.org
WORKER_SECRET=          # S... firma el Proof L0 embedded (misma que arriba si self-host)
WORKER_ADDRESS=         # G... fallback de cobro embedded (default: deriva de SETTLEMENT_SECRET)
PAYOUT_BASE=100000      # stroops base por job ($0.01)
PAYOUT_PER_TOKEN=       # opcional: stroops por genToken medido

# Agente/web: paywall x402 legado (opcional — el path de usuario es créditos).
PAYWALL_PAY_TO=
CORS_ORIGIN=            # allowlist CSV; vacío = abierto (dev)
RATE_LIMIT_RPM=120
AUDIT_RATE=0.05         # prob. de audit replay post-job (forges remotos)
BRAVE_API_KEY=          # web_search del agente; sin ella DuckDuckGo HTML
WEAVER_OLLAMA=http://localhost:11434
OPERATOR_KEY=           # key wvr_ con owner "operator" para admin (dashboard)

# ─── web (apps/web) ────────────────────────────────────────────────────────
# URL del gateway visible para el BROWSER (pública si el panel es remoto).
NEXT_PUBLIC_GATEWAY=http://localhost:3001
# Server-side (SSR/chat proxy internals):
WEAVER_GATEWAY=http://localhost:3001

# ─── forge remoto (apps/forge — ~/.weaver/forge.json via `weaver-forge init`)
# SOROBAN_RPC + SETTLEMENT_CONTRACT se pueden pasar como flags:
#   weaver-forge init --gateway http://IP:3001        # auto-detecta Ollama
#   weaver-forge up --contract C...                   # auto-register + auto-claim
#   weaver-forge claim --job N --hash HEX --sig HEX   # escape hatch manual

# ─── e2e live (apps/gateway/e2e-live.mjs) ──────────────────────────────────
# GATEWAY + FUNDER_SECRET fondean una cuenta real con USDC testnet:
#   GATEWAY=http://localhost:3001 FUNDER_SECRET=S... USDC_ISSUER=G... \
#   USDC_CODE=USDC node apps/gateway/e2e-live.mjs
